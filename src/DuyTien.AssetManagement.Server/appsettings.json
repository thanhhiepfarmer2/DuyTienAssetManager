{
  "AllowedHosts": "localhost;127.0.0.1",
  "GoogleWorkspace": {
    "AuthorizationMode": "CompanyOperatorOAuth",
    "ApplicationName": "DuyTien Asset Management",
    "MaxRetryAttempts": 3,
    "InitialRetryDelayMilliseconds": 200
  },
  "Hosting": {
    "RequireHttps": true
  },
  "Auth": {
    "MaintenanceMode": false,
    "Password": {
      "MinimumLength": 8
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "DurationMinutes": 15
    },
    "RateLimit": {
      "LoginAttempts": 10,
      "WindowMinutes": 15
    },
    "Sessions": {
      "WebIdleMinutes": 30,
      "WebAbsoluteHours": 8,
      "RememberIdleHours": 24,
      "RememberAbsoluteDays": 7,
      "MobileAccessMinutes": 15,
      "MobileRefreshIdleDays": 14,
      "MobileRefreshAbsoluteDays": 30,
      "MaxActivePerUser": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
