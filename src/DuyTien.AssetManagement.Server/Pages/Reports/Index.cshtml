@page
@model DuyTien.AssetManagement.Server.Pages.Reports.IndexModel
@using DuyTien.AssetManagement.Application.Reports
@using DuyTien.AssetManagement.Server.Reports
@{ViewData["Title"]="Báo cáo tài sản và số lượng";}
<h1>Báo cáo tài sản và số lượng</h1>
<nav aria-label="Chọn báo cáo">@foreach(var pair in ReportService.Names){<a asp-route-Code="@pair.Key" class="btn btn-outline-primary mb-2">@pair.Key — @pair.Value</a> }</nav>
<p class="alert alert-warning">Nguồn, quy tắc và ngưỡng chưa được xác nhận. Tài sản và vật tư được đếm riêng; không suy số lượng từ định mức hoặc kho mặc định.</p>
<form method="get" class="row g-2 mb-3" data-report-filter>
<input asp-for="Code" type="hidden"/>
<div class="col-md-6"><label asp-for="Q">Tìm mã/tên trong phạm vi</label><input asp-for="Q" maxlength="200" class="form-control"/></div>
<div class="col-md-6"><label asp-for="CategoryId">Danh mục</label><select asp-for="CategoryId" class="form-select"><option value="">Tất cả trong phạm vi</option>@if(Model.CategoryId is not null&&!Model.Choices.Categories.Any(c=>c.Id==Model.CategoryId)){<option value="@Model.CategoryId">@Model.CategoryId (giá trị đã nhập)</option>}@foreach(var c in Model.Choices.Categories){<option value="@c.Id">@c.Name</option>}</select></div>
<div class="col-md-6"><label asp-for="OrgUnitId">Đơn vị</label><select asp-for="OrgUnitId" class="form-select"><option value="">Tất cả trong phạm vi</option>@if(Model.OrgUnitId is not null&&!Model.Choices.OrgUnits.Any(o=>o.Id==Model.OrgUnitId)){<option value="@Model.OrgUnitId">@Model.OrgUnitId (giá trị đã nhập)</option>}@foreach(var o in Model.Choices.OrgUnits){<option value="@o.Id">@o.Name</option>}</select></div>
<div class="col-md-6"><label asp-for="LocationId">Địa điểm</label><select asp-for="LocationId" class="form-select"><option value="">Tất cả trong phạm vi</option>@if(Model.LocationId is not null&&!Model.Choices.Locations.Any(l=>l.Id==Model.LocationId)){<option value="@Model.LocationId">@Model.LocationId (giá trị đã nhập)</option>}@foreach(var l in Model.Choices.Locations){<option value="@l.Id">@l.Name</option>}</select></div>
@if(!Model.IsStock){<div class="col-md-6"><label asp-for="Type">Loại tài sản</label><select asp-for="Type" class="form-select"><option value="">Tất cả</option>@foreach(var x in Model.Choices.Types){<option value="@x">@x</option>}</select></div><div class="col-md-6"><label asp-for="Condition">Tình trạng đang lưu (chưa chốt quy tắc)</label><input asp-for="Condition" maxlength="200" class="form-control"/></div>@if(Model.Code=="R02"){<div class="col-md-6"><label asp-for="GroupLevel">Cấp F tổng hợp (1–10, rỗng = mọi cấp được phép)</label><input asp-for="GroupLevel" type="number" min="1" max="10" class="form-control"/></div>}}
else{<div class="col-md-6"><label asp-for="Unit">Đơn vị tính</label><select asp-for="Unit" class="form-select"><option value="">Từng đơn vị riêng</option>@if(Model.Unit is not null&&!Model.Choices.Units.Contains(Model.Unit)){<option value="@Model.Unit">@Model.Unit (giá trị đã nhập)</option>}@foreach(var u in Model.Choices.Units){<option value="@u">@u</option>}</select></div><div class="col-md-6"><label asp-for="Section">Kết quả / dữ liệu thiếu</label><select asp-for="Section" class="form-select">@foreach(var s in ReportService.Sections){<option value="@s">@ReportWeb.StatusNames[s]</option>}</select></div><div class="col-md-6"><label asp-for="AsOfFrom">Thời điểm số liệu từ (UTC)</label><input asp-for="AsOfFrom" type="text" class="form-control"/></div><div class="col-md-6"><label asp-for="AsOfTo">Thời điểm số liệu đến (UTC)</label><input asp-for="AsOfTo" type="text" class="form-control"/></div>}
<div class="col-md-6"><label asp-for="PageSize">Dòng/trang (1–100)</label><input asp-for="PageSize" type="number" min="1" max="100" class="form-control"/></div>
<div class="col-12"><label><input asp-for="IncludeDescendants" class="form-check-input" />Gồm danh mục con được phép</label><button type="submit" class="btn btn-primary">Xem báo cáo</button> <a asp-page="Index" asp-route-Code="@Model.Code" class="btn btn-outline-secondary">Xóa bộ lọc</a><p data-report-status role="status" aria-live="polite"></p></div>
</form>
@if(Model.Error is not null){<div class="alert alert-danger" role="alert">@Model.Error</div>}
@if(Model.Report is {} report){
<h2>@report.ReportCode — @report.Name</h2><p>Đọc lúc @report.ReadAtUtc.ToString("O") · @WebUi.State(report.DataState) · @report.Total dòng kết quả trong phân đoạn/bộ lọc · trang @report.Page</p>
@if(report.CanExport){<a href="@Url.Page("/Reports/Index","Export",Model.Routes())" class="btn btn-secondary mb-3">Xuất CSV toàn bộ kết quả theo bộ lọc</a><p>Quyền xuất được kiểm tra lại; CSV có thể hẹp hơn phạm vi xem.</p>}
@if(!Model.IsStock){<p>Tổng tài sản duy nhất trong phạm vi/bộ lọc: @report.Summary.AssetCount. Vật tư không được cộng vào số tài sản.</p>}
else{<p>@report.Summary.ItemCount vật tư riêng · @report.Summary.SnapshotCount bản ghi số lượng · thời điểm số liệu: @(report.Summary.EarliestSnapshotAsOf?.ToString("O")??"Chưa có") đến @(report.Summary.LatestSnapshotAsOf?.ToString("O")??"Chưa có")</p><ul>@foreach(var s in report.Summary.StatusCounts){<li>@ReportWeb.StatusNames[s.Status]: @s.Count</li>}</ul><p>Thiếu ngưỡng có thể trùng nhóm chưa biết/đã hết số lượng; không cộng các số kiểm tra thành tổng. Chưa có số liệu trong phạm vi không được gán địa điểm hoặc số lượng0.</p>
@if(report.Summary.Units.Count>0){<table class="table"><caption>Tổng hợp từng đơn vị trong phân đoạn đang xem, trước phân trang</caption><tr><th>Đơn vị</th><th>Dòng</th><th>Số lượng biết</th><th>Dòng chưa biết số lượng</th></tr>@foreach(var u in report.Summary.Units){<tr><td>@(string.IsNullOrEmpty(u.Unit)?"Chưa có đơn vị":u.Unit)</td><td>@u.RowCount</td><td>@(u.QuantitySum?.ToString(System.Globalization.CultureInfo.InvariantCulture)??"Chưa có tổng xác định")</td><td>@u.UnknownQuantityCount</td></tr>}</table>}}
@if(report.Total==0){<p role="status">Không có dòng phù hợp trong phạm vi và bộ lọc. Không coi đây là chứng nhận ngoài phạm vi không có dữ liệu.</p>}
@if(report.Total>0&&report.Assets.Count==0&&report.Categories.Count==0&&report.Stock.Count==0){<p role="status">Trang hiện tại không có dòng; tổng trong phạm vi vẫn là @report.Total. Dùng phân trang để quay lại.</p>}
@if(report.Assets.Count>0){<div class="table-responsive"><table class="table"><caption>Dữ liệu trong phạm vi được giao</caption><thead><tr><th>Mã/Tên</th><th>Loại/Tình trạng</th><th>Danh mục được phép</th><th>Đơn vị/Địa điểm</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var a in report.Assets){<tr><td><a asp-page="/Assets/Detail" asp-route-id="@a.AssetId">@a.ObjectCode — @a.Name</a></td><td>@a.Type / @a.Condition</td><td>@(a.PathIsPartial?"[nhánh được phép] ":"")@a.CategoryPath</td><td>@a.OrgUnitName / @a.LocationName</td><td>@WebUi.State(a.DataState) · @a.UpdatedAt.ToString("O")</td></tr>}</tbody></table></div>}
@if(report.Categories.Count>0){<p>Trực tiếp là tài sản tại đúng danh mục; cây con gồm các tài sản được phép ở các cấp con. Không cộng lặp giữa các cấp.</p><div class="table-responsive"><table class="table"><caption>Dữ liệu trong phạm vi được giao</caption><thead><tr><th>Danh mục được phép</th><th>Cấp F</th><th>Trực tiếp</th><th>Gồm cấp con</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var c in report.Categories){<tr><td>@(c.PathIsPartial?"[nhánh được phép] ":"")@c.VisiblePath</td><td>@c.FLevel</td><td>@c.DirectAssetCount</td><td>@c.SubtreeAssetCount</td><td>@WebUi.State(c.State)</td></tr>}</tbody></table></div>}
@if(report.Stock.Count>0){<div class="table-responsive"><table class="table"><caption>Dữ liệu trong phạm vi được giao</caption><thead><tr><th>Vật tư, hàng hóa</th><th>Danh mục</th><th>Địa điểm</th><th>ĐVT/Số lượng</th><th>Ngưỡng tối thiểu</th><th>Thời điểm/Nguồn</th><th>Trạng thái/Thông tin thiếu</th></tr></thead><tbody>@foreach(var s in report.Stock){<tr><td><a asp-page="/Items/Detail" asp-route-id="@s.ItemId">@s.SourceCode — @s.Name</a></td><td>@(s.PathIsPartial?"[nhánh được phép] ":"")@s.CategoryPath</td><td>@(s.LocationName??"Chưa có số liệu tại địa điểm trong phạm vi")</td><td>@s.Unit / @(s.Quantity?.ToString(System.Globalization.CultureInfo.InvariantCulture)??"UNKNOWN")</td><td>@(s.Minimum?.ToString(System.Globalization.CultureInfo.InvariantCulture)??"Chưa có ngưỡng")</td><td>@(s.AsOf?.ToString("O")??"Chưa có thời điểm số liệu") / @(string.IsNullOrWhiteSpace(s.Source)?"Chưa có nguồn":s.Source)</td><td>@ReportWeb.StatusNames[s.Status] · @s.DataState@foreach(var issue in s.Issues){<div>@issue</div>}</td></tr>}</tbody></table></div>}
<nav aria-label="Phân trang">@if(report.Page>1){<a href="@Url.Page("/Reports/Index",Model.Routes(report.Page-1))">Trang trước</a>} @if((long)report.Page*report.PageSize<report.Total){<a href="@Url.Page("/Reports/Index",Model.Routes(report.Page+1))">Trang sau</a>}</nav>
}
@section Scripts{<script src="~/js/report-filter.js" asp-append-version="true"></script>}
