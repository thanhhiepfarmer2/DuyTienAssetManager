@page "{id}"
@model DuyTien.AssetManagement.Server.Pages.Documents.DetailModel
@{ViewData["Title"]="Phiên bản biểu mẫu demo";}
<h1>Phiên bản biểu mẫu demo</h1><p class="alert alert-warning">DRAFT_DEMO / PUBLISHED_DEMO — phát hành demo có xác nhận, không phê duyệt mẫu công ty. Bản nháp/thiếu counterpart chưa làm mẫu chuẩn.</p>
@if(Model.Error is not null){<div class="alert alert-danger" role="alert">@Model.Error</div>}
@if(Model.Feedback is not null){<div class="alert alert-success" role="status">@Model.Feedback</div>}
@if(Model.Item is {} d)
{
<h2 class="h4">@d.Name — @d.BusinessCode</h2><p>@d.CategoryName · @d.Description · metadata version @d.Version</p>
@if(Model.CanManage)
{
<form method="post" class="mb-3"><input name="RequestKey" type="hidden" value="@Model.FormKey("Save")"/><input type="hidden" name="ExpectedDocumentVersion" value="@(Model.Retrying("Save")?Model.ExpectedDocumentVersion:d.Version)"/><input type="hidden" name="CategoryId" value="@d.CategoryId"/>
<label for="Name">Tên</label><input id="Name" name="Name" value="@(Model.Name??d.Name)" required maxlength="300" class="form-control"/><label for="BusinessCode">Mã nghiệp vụ</label><input id="BusinessCode" name="BusinessCode" value="@(Model.BusinessCode??d.BusinessCode)" required maxlength="100" class="form-control"/><label for="Description">Mô tả</label><textarea id="Description" name="Description" class="form-control" maxlength="2000">@(Model.Description??d.Description)</textarea><button asp-page-handler="Save" class="btn btn-primary mt-2">Lưu metadata nháp</button></form>
<form method="post" class="mb-3"><input name="RequestKey" type="hidden" value="@Model.FormKey("Version")"/><input type="hidden" name="ExpectedDocumentVersion" value="@(Model.Retrying("Version")?Model.ExpectedDocumentVersion:d.Version)"/><label asp-for="Label">Nhãn phiên bản mới</label><input asp-for="Label" required maxlength="80" class="form-control"/><button asp-page-handler="Version" class="btn btn-primary mt-2">Tạo phiên bản nháp mới</button></form>
<form method="post" class="mb-4"><input name="RequestKey" type="hidden" value="@Model.FormKey("Archive")"/><input type="hidden" name="ExpectedDocumentVersion" value="@(Model.Retrying("Archive")?Model.ExpectedDocumentVersion:d.Version)"/><label>Lý do ngừng dùng registry<input name="Reason" required maxlength="500" class="form-control"/></label><button asp-page-handler="Archive" class="btn btn-outline-danger">Ngừng dùng, giữ file/lịch sử</button></form>
}
@if(d.Versions.Count==0){<p role="status">Chưa có phiên bản hoặc chưa phát hành trong phạm vi/ngày hiệu lực.</p>}
@foreach(var v in d.Versions)
{
<section class="border rounded p-3 mb-3"><h2 class="h4">@v.Label — @v.State</h2><p>Ngày hiệu lực: @(v.EffectiveOn?.ToString("yyyy-MM-dd")??"Chưa chọn") · @(v.IsEffective?"Có hiệu lực demo":"Nháp/chưa tới ngày hiệu lực") · version @v.Version</p>
@if(v.Docx is null||v.Pdf is null||v.Docx.State!="AVAILABLE"||v.Pdf.State!="AVAILABLE"||v.Docx.IsDeleted||v.Pdf.IsDeleted){<p class="text-warning" role="status">Thiếu DOCX hoặc PDF AVAILABLE cùng version; chưa có cặp mẫu chuẩn.</p>}
@foreach(var kind in new[]{"DOCX","PDF"})
{
var f=kind=="DOCX"?v.Docx:v.Pdf;
<div class="mb-3"><h3 class="h6">@kind</h3>
@if(f is {} file)
{
<p>@file.FileName — @file.State @(file.IsDeleted?"(đã ngừng/hủy)":"")</p>
@if(file.State=="AVAILABLE"&&!file.IsDeleted){<a asp-page="/Files/Content" asp-route-id="@file.FileId">Tải @kind của @v.Label</a>@if(kind=="PDF"){<a class="ms-3" asp-page="/Files/Content" asp-route-id="@file.FileId" asp-route-preview="true" target="_blank" rel="noopener">Xem PDF cùng version</a>}}
@if(Model.CanManage&&v.State=="DRAFT"&&!file.IsDeleted&&file.State!="AVAILABLE")
{<form method="post"><input name="RequestKey" type="hidden" value="@Model.FormKey("Cancel",file.FileId)"/><input type="hidden" name="FileId" value="@file.FileId"/><input type="hidden" name="ExpectedVersion" value="@(Model.Retrying("Cancel",file.FileId)?Model.ExpectedVersion:file.Version)"/><button asp-page-handler="Reconcile" class="btn btn-outline-primary">Đối soát upload</button><label>Lý do hủy<input name="Reason" value="@(Model.Retrying("Cancel",file.FileId)?Model.Reason:"")" maxlength="500" class="form-control"/></label><button asp-page-handler="Cancel" class="btn btn-outline-danger">Hủy operation, giữ file nếu đã tạo</button></form>}
}
else{<p>Chưa có @kind cho phiên bản này.</p>}
@if(Model.CanManage&&v.State=="DRAFT"&&(f is null||f.IsDeleted||Model.Error is not null&&Model.VersionId==v.VersionId&&Model.Kind==kind&&f.State!="AVAILABLE"))
{<form method="post" enctype="multipart/form-data" data-media-upload><input name="RequestKey" type="hidden" value="@Model.FormKey("Upload",v.VersionId+":"+kind)"/><input type="hidden" name="VersionId" value="@v.VersionId"/><input type="hidden" name="Kind" value="@kind"/><input type="hidden" name="ExpectedVersion" value="@(Model.Error is not null&&Model.VersionId==v.VersionId&&Model.Kind==kind?Model.ExpectedVersion:v.Version)"/><label>Chọn @kind (giới hạn demo @Model.UploadCapLabel)<input name="Upload" type="file" accept="@(kind=="DOCX"?".docx":".pdf")" required class="form-control"/></label><button asp-page-handler="Upload" class="btn btn-primary mt-2">Upload @kind vào @v.Label</button><button type="button" data-media-cancel class="btn btn-secondary mt-2">Hủy lựa chọn</button><p data-media-status role="status" aria-live="polite"></p></form>}
</div>
}
@if(Model.CanManage&&v.State=="DRAFT")
{<form method="post"><input name="RequestKey" type="hidden" value="@Model.FormKey("Publish",v.VersionId)"/><input type="hidden" name="VersionId" value="@v.VersionId"/><input type="hidden" name="ExpectedVersion" value="@(Model.Retrying("Publish",v.VersionId)?Model.ExpectedVersion:v.Version)"/><input type="hidden" name="ExpectedDocumentVersion" value="@(Model.Retrying("Publish",v.VersionId)?Model.ExpectedDocumentVersion:d.Version)"/><label>Ngày hiệu lực demo (UTC)<input type="date" name="EffectiveOn" required class="form-control"/></label><label>Lý do phát hành<input name="Reason" required maxlength="500" class="form-control"/></label><label class="d-block"><input type="checkbox" name="ConfirmDemo" value="true" required/> Xác nhận cặp DOCX/PDF này là mẫu DEMO, không ban hành chính thức</label><button asp-page-handler="Publish" class="btn btn-danger mt-2">Phát hành demo cùng version</button></form>}
</section>
}
}
<p><a asp-page="Index">Danh sách hồ sơ/biểu mẫu</a></p>
@section Scripts{<script src="~/js/media-upload.js" asp-append-version="true"></script>}
