@page
@model ErrorModel
@{ ViewData["Title"] = "Chưa thể hoàn tất yêu cầu"; }
<section class="error-panel"><h1>Chưa thể hoàn tất yêu cầu</h1><p role="alert">Đã xảy ra lỗi khi xử lý. Nếu đang lưu, kết quả có thể chưa rõ; giữ nội dung và đối soát trước khi thử lại.</p>
@if (Model.ShowRequestId) { <p>Mã đối chiếu: <code>@Model.RequestId</code></p> }
<p>Báo mã đối chiếu và thao tác gặp lỗi cho người hỗ trợ. Không gửi mật khẩu hoặc thông tin phiên.</p><p><a asp-page="/Index" class="btn btn-primary">Về trang chủ</a> <a asp-page="/Help/Index">Hướng dẫn xử lý lỗi</a></p></section>
