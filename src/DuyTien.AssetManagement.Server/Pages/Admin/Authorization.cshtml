@page
@model DuyTien.AssetManagement.Server.Pages.Admin.AuthorizationModel
@{
    ViewData["Title"] = "Ma trận quyền";
}
<h1 class="h3">Ma trận quyền hệ thống</h1>
<p>Năm vai trò cố định, mỗi vai trò có các quyền bên dưới. Quyền thao tác còn giới hạn theo phạm vi được giao; không cấp quyền trực tiếp cho tài khoản.</p>
@foreach (var role in Model.Roles)
{
    <section class="card card-body mb-4"><h2 class="h5">@WebUi.State(role) <small class="text-muted">(@role)</small></h2><p>@string.Join(", ", Model.Permissions[role])</p></section>
}
