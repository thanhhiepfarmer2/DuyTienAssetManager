@page
@model DuyTien.AssetManagement.Server.Pages.Stock.IndexModel
@{ViewData["Title"]="Số lượng theo thời điểm";}
<h1>Số lượng theo thời điểm</h1><p>Số lượng ghi nhận tại một thời điểm, không phải sổ nhập xuất. Chưa có số lượng khác với0; mỗi đơn vị tính được giữ riêng.</p>
@if(Model.Error is not null){<div class="alert alert-danger" role="alert">@Model.Error</div>}
@if(Model.Saved is {} b){<div class="alert alert-success" role="status">Đã lưu số lượng: <span data-state="@b.StockStatus" class="state-badge">@WebUi.State(b.StockStatus)</span> · Phiên bản @b.Version · @b.AsOf.ToString("O")</div>}
<form method="get"><label asp-for="Q">Tìm mã vật tư, địa điểm hoặc nguồn</label><input asp-for="Q" maxlength="200" class="form-control" /><button class="btn btn-primary">Tìm</button></form>
@if(Model.Result.Items.Count==0){<p>Chưa có số liệu trong phạm vi: chưa biết số lượng, không tự gán bằng 0.</p>}
else{<div class="table-responsive"><table class="table"><tr><th>Vật tư, hàng hóa</th><th>Địa điểm</th><th>ĐVT</th><th>Số lượng</th><th>Ngưỡng tối thiểu</th><th>Trạng thái</th><th>Thời điểm/Nguồn</th><th>Phiên bản</th></tr>@foreach(var r in Model.Result.Items){<tr><td><a asp-page="/Items/Detail" asp-route-id="@r.ItemId">@r.ItemId</a></td><td>@r.LocationId</td><td>@r.Unit</td><td>@(r.Quantity?.ToString()??"Chưa biết")</td><td>@(r.Minimum?.ToString()??"Chưa có ngưỡng")</td><td><span data-state="@r.StockStatus" class="state-badge">@WebUi.State(r.StockStatus)</span></td><td>@r.AsOf.ToString("O") · @r.Source</td><td><a asp-route-ItemId="@r.ItemId" asp-route-LocationId="@r.LocationId" asp-route-Unit="@r.Unit" asp-route-ExpectedVersion="@r.Version">@r.Version · cập nhật</a></td></tr>}</table></div>}
<p>@Model.Result.Total bản ghi số lượng trong phạm vi · trang @Model.PageNumber</p>
@if(Model.PageNumber>1){<a asp-route-PageNumber="@(Model.PageNumber-1)" asp-route-Q="@Model.Q">Trang trước</a>}
@if(Model.PageNumber*20<Model.Result.Total){<a asp-route-PageNumber="@(Model.PageNumber+1)" asp-route-Q="@Model.Q">Trang sau</a>}
@if(Model.CanUpdate){<form method="post" data-inventory-form><label asp-for="ItemId">Mã nhận diện vật tư đã phân loại và xác nhận theo dõi</label><input asp-for="ItemId" class="form-control" /><label asp-for="LocationId">Địa điểm</label><select asp-for="LocationId" class="form-select"><option value="">Chọn địa điểm</option>@if(!string.IsNullOrEmpty(Model.LocationId)&&!Model.Choices.Locations.Any(l=>l.Id==Model.LocationId)){<option value="@Model.LocationId">@Model.LocationId (giá trị đã nhập)</option>}@foreach(var l in Model.Choices.Locations){<option value="@l.Id">@l.Name</option>}</select><label asp-for="Unit">Đơn vị tính chính</label><input asp-for="Unit" class="form-control" /><label asp-for="Quantity">Số lượng (để trống khi chưa biết)</label><input asp-for="Quantity" type="number" step="any" min="0" class="form-control" /><label asp-for="Minimum">Ngưỡng tối thiểu (rỗng = chưa xác lập)</label><input asp-for="Minimum" type="number" step="any" min="0" class="form-control" /><label asp-for="AsOf">Thời điểm số liệu (UTC, ví dụ2026-10-13T01:00:00Z)</label><input asp-for="AsOf" type="text" class="form-control" /><label asp-for="Source">Nguồn số liệu (ghi rõ GIẢ cho dữ liệu kiểm thử)</label><input asp-for="Source" maxlength="500" class="form-control" /><label asp-for="Reason">Lý do</label><input asp-for="Reason" maxlength="1000" class="form-control" /><input asp-for="ExpectedVersion" type="hidden"/><input asp-for="RequestKey" type="hidden"/><button type="submit" class="btn btn-primary">Lưu số lượng</button><p data-submit-status role="status" aria-live="polite"></p></form><details><summary>Địa điểm được phép (nguồn chưa xác minh)</summary><ul>@foreach(var l in Model.Choices.Locations){<li>@l.Id — @l.Name</li>}</ul></details>}
<a asp-page="/Items/Index">Danh sách vật tư, hàng hóa</a>
@section Scripts{<script src="~/js/inventory-form.js" asp-append-version="true"></script>}
