@page
@model DuyTien.AssetManagement.Server.Pages.Stock.IndexModel
@{ViewData["Title"]="Snapshot số lượng";}
<h1>Snapshot số lượng — DRAFT_DEMO</h1><p>Chỉ snapshot tại thời điểm asOf, không phải sổ nhập/xuất. Thiếu số lượng = UNKNOWN, khác0. Đơn vị exact theo Item, không cộng/đổi ngầm.</p>
@if(Model.Error is not null){<div class="alert alert-danger" role="alert">@Model.Error</div>}
@if(Model.Saved is {} b){<div class="alert alert-success" role="status">Snapshot đã xác nhận: @b.StockStatus · Version @b.Version · @b.AsOf.ToString("O")</div>}
<form method="get"><label asp-for="Q">Tìm ItemId/LocationId/nguồn</label><input asp-for="Q" maxlength="200"/><button>Tìm</button></form>
@if(Model.Result.Items.Count==0){<p>Chưa có snapshot trong phạm vi: số lượng UNKNOWN; không tạo0 tự động.</p>}
else{<div class="table-responsive"><table class="table"><tr><th>Item</th><th>Địa điểm</th><th>ĐVT</th><th>Số lượng</th><th>Min</th><th>Trạng thái</th><th>AsOf/Nguồn</th><th>Version</th></tr>@foreach(var r in Model.Result.Items){<tr><td><a asp-page="/Items/Detail" asp-route-id="@r.ItemId">@r.ItemId</a></td><td>@r.LocationId</td><td>@r.Unit</td><td>@(r.Quantity?.ToString()??"UNKNOWN")</td><td>@(r.Minimum?.ToString()??"Chưa có ngưỡng")</td><td>@r.StockStatus</td><td>@r.AsOf.ToString("O") · @r.Source</td><td><a asp-route-ItemId="@r.ItemId" asp-route-LocationId="@r.LocationId" asp-route-Unit="@r.Unit" asp-route-ExpectedVersion="@r.Version">@r.Version · cập nhật</a></td></tr>}</table></div>}
<p>@Model.Result.Total snapshot trong phạm vi · trang @Model.PageNumber</p>
@if(Model.PageNumber>1){<a asp-route-PageNumber="@(Model.PageNumber-1)" asp-route-Q="@Model.Q">Trang trước</a>}
@if(Model.PageNumber*20<Model.Result.Total){<a asp-route-PageNumber="@(Model.PageNumber+1)" asp-route-Q="@Model.Q">Trang sau</a>}
@if(Model.CanUpdate){<form method="post" data-inventory-form><label asp-for="ItemId">ItemId đã phân loại và tracking xác nhận</label><input asp-for="ItemId"/><label asp-for="LocationId">Địa điểm</label><select asp-for="LocationId"><option value="">Chọn địa điểm</option>@if(!string.IsNullOrEmpty(Model.LocationId)&&!Model.Choices.Locations.Any(l=>l.Id==Model.LocationId)){<option value="@Model.LocationId">@Model.LocationId (giá trị đã nhập)</option>}@foreach(var l in Model.Choices.Locations){<option value="@l.Id">@l.Name</option>}</select><label asp-for="Unit">Đơn vị chính exact</label><input asp-for="Unit"/><label asp-for="Quantity">Quantity (rỗng = UNKNOWN)</label><input asp-for="Quantity" type="number" step="any" min="0"/><label asp-for="Minimum">Ngưỡng tối thiểu (rỗng = chưa xác lập)</label><input asp-for="Minimum" type="number" step="any" min="0"/><label asp-for="AsOf">AsOf ISO UTC, ví dụ2026-10-13T01:00:00Z</label><input asp-for="AsOf" type="text"/><label asp-for="Source">Nguồn snapshot (ghi rõ GIẢ khi demo)</label><input asp-for="Source" maxlength="500"/><label asp-for="Reason">Lý do</label><input asp-for="Reason" maxlength="1000"/><input asp-for="ExpectedVersion" type="hidden"/><input asp-for="RequestKey" type="hidden"/><button type="submit">Lưu snapshot riêng</button><p data-submit-status role="status" aria-live="polite"></p></form><details><summary>Địa điểm được phép (nguồn chưa xác minh)</summary><ul>@foreach(var l in Model.Choices.Locations){<li>@l.Id — @l.Name</li>}</ul></details>}
<a asp-page="/Items/Index">Danh sách Items</a>
@section Scripts{<script src="~/js/inventory-form.js" asp-append-version="true"></script>}
