@model DuyTien.AssetManagement.Server.Assets.AssetForm
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="row g-3">
    <div class="col-12"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" required maxlength="300" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" class="form-select" required><option value="">Chọn danh mục nháp</option>@if (!string.IsNullOrEmpty(Model.CategoryId) && !Model.Choices.Categories.Any(x => x.Id == Model.CategoryId)) { <option value="@Model.CategoryId">@Model.CategoryId — cần tải lại dữ liệu chọn</option> }@foreach (var x in Model.Choices.Categories) { <option value="@x.Id">@x.Name</option> }</select><span asp-validation-for="CategoryId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="OrgUnitId" class="form-label"></label><select asp-for="OrgUnitId" class="form-select" required><option value="">Chọn đơn vị</option>@if (!string.IsNullOrEmpty(Model.OrgUnitId) && !Model.Choices.OrgUnits.Any(x => x.Id == Model.OrgUnitId)) { <option value="@Model.OrgUnitId">@Model.OrgUnitId — cần tải lại dữ liệu chọn</option> }@foreach (var x in Model.Choices.OrgUnits) { <option value="@x.Id">@x.Name</option> }</select><span asp-validation-for="OrgUnitId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="LocationId" class="form-label"></label><select asp-for="LocationId" class="form-select" required><option value="">Chọn địa điểm</option>@if (!string.IsNullOrEmpty(Model.LocationId) && !Model.Choices.Locations.Any(x => x.Id == Model.LocationId)) { <option value="@Model.LocationId">@Model.LocationId — cần tải lại dữ liệu chọn</option> }@foreach (var x in Model.Choices.Locations) { <option value="@x.Id">@x.Name</option> }</select><span asp-validation-for="LocationId" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="CustodianRef" class="form-label"></label><input asp-for="CustodianRef" class="form-control" maxlength="200" /></div>
    <div class="col-md-6"><label asp-for="Serial" class="form-label"></label><input asp-for="Serial" class="form-control" maxlength="200" /></div>
    <div class="col-md-4"><label asp-for="Model" class="form-label"></label><input asp-for="Model" class="form-control" maxlength="200" /></div>
    <div class="col-md-4"><label asp-for="Manufacturer" class="form-label"></label><input asp-for="Manufacturer" class="form-control" maxlength="200" /></div>
    <div class="col-md-4"><label asp-for="RecordedOn" class="form-label"></label><input asp-for="RecordedOn" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Condition" class="form-label"></label><input asp-for="Condition" class="form-control" required maxlength="100" /></div>
    <div class="col-md-6"><label asp-for="AliasesText" class="form-label"></label><textarea asp-for="AliasesText" class="form-control" rows="3"></textarea><span asp-validation-for="AliasesText" class="text-danger"></span><small>Mapping demo tự nhập; không xác nhận mã nguồn công ty.</small></div>
    <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3" maxlength="2000"></textarea></div>
</div>
