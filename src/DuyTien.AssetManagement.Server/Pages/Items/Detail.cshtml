@page "{id}"
@model DuyTien.AssetManagement.Server.Pages.Items.DetailModel
@{ViewData["Title"]="Chi tiết vật tư, hàng hóa";}
<h1>Chi tiết vật tư, hàng hóa</h1>
@if(Model.Error is not null){<div class="alert alert-danger" role="alert">@Model.Error</div>}
@if(Model.Item is {} item){<p>@item.Name · @WebUi.State(item.State) · Phiên bản @item.Version · ID @item.ItemId</p><p>Danh mục @item.CategoryId · Theo dõi số lượng: @(item.StockTracked is true ? "Có" : item.StockTracked is false ? "Không" : "Chưa xác nhận"). Khi thiếu số liệu, đây là chưa biết số lượng, không phải bằng 0.</p><a asp-page="/Stock/Index" asp-route-ItemId="@item.ItemId" asp-route-Unit="@item.PrimaryUnit">Xem và ghi số lượng theo thời điểm</a><dl>@for(var col=0;col<20;col++){<dt>Cột @(col+1): @DuyTien.AssetManagement.Application.Inventory.ItemImportReader.Headers[col]</dt><dd>@item.Cells[col]</dd>}</dl>}
<a asp-page="Index">Danh sách vật tư, hàng hóa</a>
