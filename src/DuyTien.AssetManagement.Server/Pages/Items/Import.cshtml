@page
@model DuyTien.AssetManagement.Server.Pages.Items.ImportModel
@{ViewData["Title"]="Nhập vật tư, hàng hóa";}
<h1>Nhập vật tư, hàng hóa</h1><p class="alert alert-warning">Nguồn gốc chưa được đối chiếu. Kiểm đúng định dạng dữ liệu trước khi nhập. Vật tư, tài sản và số lượng được quản lý riêng; chọn danh mục và xử lý mã trùng trước khi xác nhận.</p>
@if(Model.Error is not null){<div class="alert alert-danger" role="alert">@Model.Error</div>}
@if(Model.Saved is {} saved){<div class="alert alert-success" role="status">Đã lưu tiến độ lần nhập @saved.JobId: <span class="state-badge" data-state="@saved.State">@WebUi.State(saved.State)</span>, @saved.Processed/@saved.PlannedCount. Chỉ trạng thái Hoàn tất mới xác nhận nhập xong.</div>}
@if(Model.Saved is null){<form method="post" enctype="multipart/form-data" data-inventory-form>
<label asp-for="Upload">File XLSX/JSON (tối đa32MiB)</label><input asp-for="Upload" type="file" accept=".xlsx,.json" class="form-control" />
<details><summary>Dữ liệu chuẩn bị dạng JSON (tùy chọn, nâng cao)</summary>
<label asp-for="DocumentJson">Dữ liệu đã đọc, giữ để tiếp tục khi có lỗi</label><textarea asp-for="DocumentJson" rows="5" class="form-control"></textarea>
<label asp-for="GroupsJson">Phân loại nhóm từ tệp JSON đã chuẩn bị</label><textarea asp-for="GroupsJson" rows="2" class="form-control"></textarea>
<label asp-for="DecisionsJson">Quyết định từ tệp JSON đã chuẩn bị</label><textarea asp-for="DecisionsJson" rows="2" class="form-control"></textarea></details>
@if(Model.GroupRows.Count>0){<h2>Gán nhóm nguồn vào danh mục nháp</h2><p>Chọn danh mục theo từng nhóm. Chưa phân loại sẽ cách ly; quyền Admin đủ phạm vi mới được nhập dòng cách ly. Theo dõi số lượng phải xác nhận riêng, không suy ra từ kho/BOM.</p><div class="table-responsive"><table class="table"><tr><th>Nhóm nguồn</th><th>Danh mục</th><th>Theo dõi số lượng</th></tr>
@for(var i=0;i<Model.GroupRows.Count;i++){<tr><td>@Model.GroupRows[i].SourceGroup<input asp-for="GroupRows[i].SourceGroup" type="hidden"/></td><td><select asp-for="GroupRows[i].CategoryId" class="form-select"><option value="">Chưa phân loại — cách ly</option>@if(!string.IsNullOrEmpty(Model.GroupRows[i].CategoryId)&&!Model.Choices.Categories.Any(c=>c.Id==Model.GroupRows[i].CategoryId)){<option value="@Model.GroupRows[i].CategoryId">@Model.GroupRows[i].CategoryId (giá trị đã nhập)</option>}@foreach(var c in Model.Choices.Categories){<option value="@c.Id">@c.Name</option>}</select></td><td><select asp-for="GroupRows[i].Tracking" class="form-select"><option value="">Chưa xác nhận</option><option value="YES">Có — vật tư theo đơn vị chính</option><option value="NO">Không</option></select></td></tr>}
</table></div>}
@if(Model.DuplicateRows.Count>0){<h2>Quyết định mã nguồn trùng</h2>@for(var i=0;i<Model.DuplicateRows.Count;i++){<fieldset class="border p-3 mb-3"><legend>@Model.DuplicateRows[i].SourceCode</legend><input asp-for="DuplicateRows[i].SourceCode" type="hidden"/><label asp-for="DuplicateRows[i].Mode">Cách xử lý</label><select asp-for="DuplicateRows[i].Mode" class="form-select"><option value="">Chưa quyết định — chưa thể nhập</option><option value="MERGE">Gộp khi cả20cột đồng nhất</option><option value="SPLIT">Giữ riêng, xác lập khóa nguồn khác nhau</option></select><label asp-for="DuplicateRows[i].Reason">Lý do quyết định</label><input asp-for="DuplicateRows[i].Reason" maxlength="1000" class="form-control"/><p>Chỉ khi giữ riêng: nhập khóa nguồn ổn định từng dòng; số dòng chỉ truy xuất nguồn, không là ID hệ thống.</p>@for(var j=0;j<Model.DuplicateRows[i].Identities.Count;j++){<label asp-for="DuplicateRows[i].Identities[j].Identity">Dòng @Model.DuplicateRows[i].Identities[j].SourceRow — khóa nguồn riêng</label><input asp-for="DuplicateRows[i].Identities[j].SourceRow" type="hidden"/><input asp-for="DuplicateRows[i].Identities[j].Identity" maxlength="200" class="form-control"/>}</fieldset>}}
<label asp-for="Reason">Lý do nhập và lựa chọn xử lý</label><input asp-for="Reason" maxlength="1000" class="form-control"/>
<input asp-for="RequestKey" type="hidden"/><input asp-for="PreviewHash" type="hidden"/><input asp-for="Revision" type="hidden"/>
<button asp-page-handler="Preview" type="submit" class="btn btn-secondary">Xem trước / kiểm tra lại lựa chọn</button>
@if(Model.PreviewHash is not null && (Model.Preview is null || Model.Preview.Errors.Count==0)){<label><input asp-for="Confirm" class="form-check-input" />Xác nhận phân loại, quyết định mã trùng và dữ liệu chưa duyệt</label><button asp-page-handler="Start" data-confirm-action="Xác nhận thực hiện thao tác trên đối tượng đang chọn?" type="submit" class="btn btn-primary">Chuẩn bị dữ liệu và bắt đầu nhập</button>}
<p data-submit-status role="status" aria-live="polite"></p></form>}
@if(Model.Preview is {} p){@foreach(var w in p.Warnings){<p>@w</p>}<p>@p.TotalSourceRows nguồn / @p.PlannedCount vật tư; thêm @p.Added, sửa @p.Updated, giữ nguyên @p.Skipped, cách ly @p.Quarantined.</p>@foreach(var e in p.Errors){<div class="alert alert-danger">Dòng @e.SourceRow: @e.Message</div>}<table class="table"><tr><th >Dòng nguồn</th><th>Mã nguồn</th><th>Tên</th><th >Thay đổi</th><th >Danh mục</th></tr>@foreach(var d in p.Diff){<tr><td>@d.SourceRow</td><td>@d.SourceCode</td><td>@d.Name</td><td><span data-state="@d.Action">@WebUi.State(d.Action)</span> · phiên bản @d.ExpectedVersion</td><td>@d.CategoryId</td></tr>}</table><p>Bản xem trước hiển thị tối đa 20 dòng.</p>}
<details><summary>Danh mục chưa duyệt trong phạm vi</summary><ul>@foreach(var c in Model.Choices.Categories){<li>@c.Id — @c.Name</li>}</ul></details>
@{var jobs=Model.Saved is null?Model.Jobs:new[]{Model.Saved};}
@foreach(var j in jobs){<section><h2 class="h5">Lần nhập @j.JobId</h2><p><span class="state-badge" data-state="@j.State">@WebUi.State(j.State)</span>: @j.Processed/@j.PlannedCount vật tư · @j.TotalSourceRows nguồn</p>@if(j.State is "VALIDATED" or "PARTIAL"){<form method="post" asp-page-handler="Chunk" data-inventory-form><input type="hidden" name="JobId" value="@j.JobId"/><input type="hidden" name="ExpectedProgress" value="@j.Processed"/><input type="hidden" name="RequestKey" value="@(j.JobId.Replace("IMPORT-","")+"-"+j.Processed)"/><button type="submit" class="btn btn-primary">Lưu nhóm tiếp theo (tối đa100 vật tư)</button><p data-submit-status role="status"></p></form>}else if(j.State=="STAGING"){<p>Dữ liệu chuẩn bị chưa đủ, chưa ghi vật tư. Giữ cùng nguồn và yêu cầu để tiếp tục; lần nhập chưa hoàn tất.</p>}</section>}
<a asp-page="Index">Danh sách vật tư, hàng hóa</a>
@section Scripts{<script src="~/js/inventory-form.js" asp-append-version="true"></script>}
