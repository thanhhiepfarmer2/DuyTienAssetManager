@page
@model DuyTien.AssetManagement.Server.Pages.Items.ImportModel
@{ViewData["Title"]="Import Items";}
<h1>Import Items — DRAFT_DEMO</h1><p>Workbook gốc chưa đối chiếu. Mã nguồn text không là ObjectCode. Không tạo Asset/tồn từ20cột; mapping Category theo ID tường minh. Mã trùng cần MERGE đồng nhất hoặc SPLIT với identity và lý do.</p>
@if(Model.Error is not null){<div class="alert alert-danger" role="alert">@Model.Error</div>}
@if(Model.Saved is {} saved){<div class="alert alert-success" role="status">Đã xác nhận checkpoint job @saved.JobId: @saved.State, @saved.Processed/@saved.PlannedCount. Chỉ COMPLETE là hoàn tất.</div>}
@if(Model.Saved is null){<form method="post" enctype="multipart/form-data" data-inventory-form>
<label asp-for="Upload">File XLSX/JSON (tối đa32MiB)</label><input asp-for="Upload" type="file" accept=".xlsx,.json"/>
<details><summary>Dữ liệu staging JSON (tùy chọn/nâng cao)</summary>
<label asp-for="DocumentJson">Dữ liệu đã đọc, giữ để tiếp tục khi có lỗi</label><textarea asp-for="DocumentJson" rows="5" class="form-control"></textarea>
<label asp-for="GroupsJson">Mapping từ tệp JSON đã chuẩn bị</label><textarea asp-for="GroupsJson" rows="2" class="form-control"></textarea>
<label asp-for="DecisionsJson">Quyết định từ tệp JSON đã chuẩn bị</label><textarea asp-for="DecisionsJson" rows="2" class="form-control"></textarea></details>
@if(Model.GroupRows.Count>0){<h2>Gán nhóm nguồn vào danh mục nháp</h2><p>Chọn danh mục theo từng nhóm. Chưa phân loại sẽ cách ly; quyền Admin đủ phạm vi mới được nhập dòng cách ly. Theo dõi số lượng phải xác nhận riêng, không suy ra từ kho/BOM.</p><div class="table-responsive"><table class="table"><tr><th>Nhóm nguồn</th><th>Danh mục nháp</th><th>Theo dõi số lượng</th></tr>
@for(var i=0;i<Model.GroupRows.Count;i++){<tr><td>@Model.GroupRows[i].SourceGroup<input asp-for="GroupRows[i].SourceGroup" type="hidden"/></td><td><select asp-for="GroupRows[i].CategoryId" class="form-select"><option value="">Chưa phân loại — cách ly</option>@if(!string.IsNullOrEmpty(Model.GroupRows[i].CategoryId)&&!Model.Choices.Categories.Any(c=>c.Id==Model.GroupRows[i].CategoryId)){<option value="@Model.GroupRows[i].CategoryId">@Model.GroupRows[i].CategoryId (giá trị đã nhập)</option>}@foreach(var c in Model.Choices.Categories){<option value="@c.Id">@c.Name</option>}</select></td><td><select asp-for="GroupRows[i].Tracking" class="form-select"><option value="">Chưa xác nhận</option><option value="YES">Có — vật tư theo đơn vị chính</option><option value="NO">Không</option></select></td></tr>}
</table></div>}
@if(Model.DuplicateRows.Count>0){<h2>Quyết định mã nguồn trùng</h2>@for(var i=0;i<Model.DuplicateRows.Count;i++){<fieldset class="border p-3 mb-3"><legend>@Model.DuplicateRows[i].SourceCode</legend><input asp-for="DuplicateRows[i].SourceCode" type="hidden"/><label asp-for="DuplicateRows[i].Mode">Cách xử lý</label><select asp-for="DuplicateRows[i].Mode" class="form-select"><option value="">Chưa quyết định — chặn import</option><option value="MERGE">Gộp khi cả20cột đồng nhất</option><option value="SPLIT">Giữ riêng, xác lập khóa nguồn khác nhau</option></select><label asp-for="DuplicateRows[i].Reason">Lý do quyết định</label><input asp-for="DuplicateRows[i].Reason" maxlength="1000" class="form-control"/><p>Chỉ khi giữ riêng: nhập khóa nguồn ổn định từng dòng; số dòng chỉ truy xuất nguồn, không là ID hệ thống.</p>@for(var j=0;j<Model.DuplicateRows[i].Identities.Count;j++){<label asp-for="DuplicateRows[i].Identities[j].Identity">Dòng @Model.DuplicateRows[i].Identities[j].SourceRow — khóa nguồn riêng</label><input asp-for="DuplicateRows[i].Identities[j].SourceRow" type="hidden"/><input asp-for="DuplicateRows[i].Identities[j].Identity" maxlength="200" class="form-control"/>}</fieldset>}}
<label asp-for="Reason">Lý do import/decision</label><input asp-for="Reason" maxlength="1000" class="form-control"/>
<input asp-for="RequestKey" type="hidden"/><input asp-for="PreviewHash" type="hidden"/><input asp-for="Revision" type="hidden"/>
<button asp-page-handler="Preview" type="submit" class="btn btn-secondary">Xem trước / kiểm tra lại lựa chọn</button>
@if(Model.PreviewHash is not null && (Model.Preview is null || Model.Preview.Errors.Count==0)){<label><input asp-for="Confirm"/>Xác nhận mapping, quyết định mã trùng và dữ liệu nháp</label><button asp-page-handler="Start" type="submit" class="btn btn-primary">Lưu staging/khởi tạo job</button>}
<p data-submit-status role="status" aria-live="polite"></p></form>}
@if(Model.Preview is {} p){@foreach(var w in p.Warnings){<p>@w</p>}<p>@p.TotalSourceRows nguồn / @p.PlannedCount Item; thêm @p.Added, sửa @p.Updated, skip @p.Skipped, quarantine @p.Quarantined.</p>@foreach(var e in p.Errors){<div class="alert alert-danger">Dòng @e.SourceRow: @e.Message</div>}<table class="table"><tr><th>Row</th><th>Mã nguồn</th><th>Tên</th><th>Diff</th><th>CategoryId</th></tr>@foreach(var d in p.Diff){<tr><td>@d.SourceRow</td><td>@d.SourceCode</td><td>@d.Name</td><td>@d.Action/v@d.ExpectedVersion</td><td>@d.CategoryId</td></tr>}</table><p>Preview UI tối đa20 dòng; API có page/pageSize.</p>}
<details><summary>CategoryId được phép (DRAFT)</summary><ul>@foreach(var c in Model.Choices.Categories){<li>@c.Id — @c.Name</li>}</ul></details>
@{var jobs=Model.Saved is null?Model.Jobs:new[]{Model.Saved};}
@foreach(var j in jobs){<section><h2>@j.JobId</h2><p>@j.State: @j.Processed/@j.PlannedCount Item · @j.TotalSourceRows nguồn</p>@if(j.State is "VALIDATED" or "PARTIAL"){<form method="post" asp-page-handler="Chunk" data-inventory-form><input type="hidden" name="JobId" value="@j.JobId"/><input type="hidden" name="ExpectedProgress" value="@j.Processed"/><input type="hidden" name="RequestKey" value="@(j.JobId.Replace("IMPORT-","")+"-"+j.Processed)"/><button type="submit">Commit chunk kế tiếp (tối đa100 Item)</button><p data-submit-status role="status"></p></form>}else if(j.State=="STAGING"){<p>Staging chưa đủ, chưa ghi Items. Gửi lại cùng file/mapping/key để tiếp tục; không coi là COMPLETE.</p>}</section>}
<a asp-page="Index">Danh sách Items</a>
@section Scripts{<script src="~/js/inventory-form.js" asp-append-version="true"></script>}
